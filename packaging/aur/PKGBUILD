# Maintainer: linuxbren <linuxbren@gmail.com>
pkgname=flyover
pkgver=0.1.0
pkgrel=1
pkgdesc="A real-time ADS-B radar scope for your terminal, built for Omarchy"
arch=('x86_64')
url="https://github.com/linuxbren/flyover"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
# ring (a transitive dep via rustls/ureq) ships precompiled assembly object
# files for its crypto primitives. Arch's default LTO (LDFLAGS -flto=auto)
# breaks linking against them -- undefined ring_core_* symbols at link time
# -- since they aren't LTO-bitcode-compatible. Confirmed: the exact same
# `cargo build --release` succeeds outside makepkg's LTO-enabled environment.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/linuxbren/flyover/archive/v$pkgver.tar.gz")
sha256sums=('8a576d376dd971f082f8393e904d0f146ee66a9daf88a2faffd4f5137d5aa5c1')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
